# Athena nightly tasks (installed by install.sh)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
15 3 * * * root cd @INSTALL_DIR@ && docker compose run --rm -T api flask purge-deleted >> /var/log/athena-purge.log 2>&1
30 3 * * * root cd @INSTALL_DIR@ && docker compose run --rm -T api flask purge-sessions >> /var/log/athena-purge.log 2>&1
45 2 * * * root ATHENA_DIR=@INSTALL_DIR@ /usr/local/sbin/athena-backup >> /var/log/athena-backup.log 2>&1
