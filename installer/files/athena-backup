#!/usr/bin/env bash
# Runs one backup, then copies backups to a connected USB backup drive (if there is one).
# Called every night by cron, by 'athena backup', and when a backup drive is plugged in.
set -Eeuo pipefail
[ "$(id -u)" -eq 0 ] || { echo "Run as root: sudo athena-backup" >&2; exit 1; }
LIB="${ATHENA_LIB:-/usr/local/lib/athena}"
# shellcheck source=/dev/null
. "$LIB/backup.sh"
# shellcheck source=/dev/null
[ -r "$LIB/usb.sh" ] && . "$LIB/usb.sh"
exec 9>/run/athena-backup.lock
flock -n 9 || { blog "Another backup is already running."; exit 0; }
rc=0
run_backup || rc=$?
# Copy to USB even if tonight's backup failed, so a plugged-in drive still gets the older ones.
if declare -F usb_sync_all >/dev/null; then usb_sync_all || true; fi
exit "$rc"