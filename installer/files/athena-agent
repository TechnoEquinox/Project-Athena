"""Athena server agent: the only part of Athena that does privileged work on the server.

It runs as root, but it never runs anything that a request tells it to. A request only
names an action; the commands for each action are written in ACTIONS below.

    athena-agent run-queue   do the requests waiting in the requests folder (systemd runs this)
    athena-agent health      write the server health file (a systemd timer runs this each minute)
    athena-agent check       do a safe self-check and print the result
"""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time

AGENT_DIR = os.environ.get("ATHENA_AGENT_DIR", "/var/lib/athena/agent")
ATHENA_DIR = os.environ.get("ATHENA_DIR", "/opt/athena")
PROC = os.environ.get("ATHENA_PROC", "/proc")
REQUEST_UID = int(os.environ.get("ATHENA_REQUEST_UID", "1000"))  # the web app's user ID
BACKUP_DIR = os.environ.get("ATHENA_BACKUP_DIR", "/var/backups/athena")
STATE_DIR = os.environ.get("ATHENA_STATE_DIR", "/var/lib/athena")
CONF_DIR = os.environ.get("ATHENA_CONF_DIR", "/etc/athena")
LOCK_FILE = os.environ.get("ATHENA_AGENT_LOCK", "/run/athena-agent.lock")
MAX_AGE = 300           # seconds: older requests are ignored
MAX_REQUEST_BYTES = 4096
KEEP_JOBS = 50          # how many finished jobs (status + log) to keep
HISTORY_POINTS = 1440   # one point a minute = 24 hours
ID_RE = re.compile(r"^[0-9a-f]{32}$")
SIZES_EVERY = 600       # seconds beteen measurements of the Athena folder and the database
BACKUP_RE = re.compile(r"^athena-backup-\d{8}-\d{6}\.tar\.age$")

REQUESTS = os.path.join(AGENT_DIR, "requests")
OUT = os.path.join(AGENT_DIR, "out")
STATUS = os.path.join(OUT, "status")
LOGS = os.path.join(OUT, "logs")

APT_ENV = dict(os.environ, DEBIAN_FRONTEND="noninteractive", LC_ALL="C")


# --- the actions. Each step is a fixed command; nothing here comes from a request. ---
def _steps(*cmds):
    return [list(c) for c in cmds]


ACTIONS = {
    "backup": {
        "label": "Back up now",
        "steps": _steps(["/usr/local/sbin/athena-backup"]),
        "env": {"ATHENA_DIR": ATHENA_DIR},
    },
    "check-updates": {
        "label": "Check for Ubuntu updates",
        "steps": _steps(["apt-get", "update"]),
        "after": "parse_updates",
        "env": APT_ENV,
    },
    "apply-updates": {
        "label": "Install Ubuntu updates",
        "steps": _steps(
            ["apt-get", "update"],
            ["apt-get", "-y", "-o", "Dpkg::Options::=--force-confold", "full-upgrade"],
            ["apt-get", "-y", "autoremove"],
        ),
        "after": "parse_updates",
        "env": APT_ENV,
    },
    "restart-services": {
        "label": "Restart Athena",
        "steps": _steps(["docker", "compose", "restart"]),
        "cwd": ATHENA_DIR,
    },
    "docker-cleanup": {
        "label": "Clean up unused Docker files",
        "steps": _steps(["docker", "image", "prune", "-f"], ["docker", "builder", "prune", "-f"]),
    },
    "reboot": {
        "label": "Restart the server",
        "steps": [],
        "after": "do_reboot",
    },
}


def log(msg):
    print(f"[athena-agent] {msg}", flush=True)


def now():
    return int(time.time())


def write_json(path, data, mode=0o644):
    """Write a file so a reader never sees half of it."""
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def ensure_dirs():
    for d in (OUT, STATUS, LOGS):
        os.makedirs(d, mode=0o755, exist_ok=True)
        os.chmod(d, 0o755)


# --- reading requests safely ---
def load_request(path):
    """Return (request, problem). A request is accepted only if every check passes."""
    try:
        st = os.lstat(path)
    except OSError:
        return None, "request vanished"
    if not os.path.isfile(path) or os.path.islink(path):
        return None, "not a plain file"
    if st.st_uid != REQUEST_UID:
        return None, "wrong owner"
    if st.st_size > MAX_REQUEST_BYTES:
        return None, "too large"
    try:
        with open(path) as f:
            req = json.load(f)
    except (OSError, ValueError):
        return None, "not valid JSON"
    if not isinstance(req, dict):
        return None, "not an object"
    rid = req.get("id")
    if not isinstance(rid, str) or not ID_RE.match(rid):
        return None, "bad id"
    if os.path.basename(path) != f"{rid}.json":
        return None, "file name does not match id"
    action = req.get("action")
    if not isinstance(action, str) or action not in ACTIONS:
        return None, "unknown action"
    ts = req.get("requested_at")
    if not isinstance(ts, int) or isinstance(ts, bool):
        return None, "bad time"
    age = now() - ts
    if age > MAX_AGE:
        return None, "request too old"
    if age < -60:
        return None, "request is from the future"
    by = req.get("requested_by", "")
    req["requested_by"] = by[:64] if isinstance(by, str) else ""
    return req, None


def set_status(rid, **fields):
    path = os.path.join(STATUS, f"{rid}.json")
    cur = read_json(path, {}) or {}
    cur.update(fields)
    write_json(path, cur)


def rejected(path, why):
    """Record that a request was refused, using the file name only if it looks like an id."""
    name = os.path.basename(path)[:-5] if path.endswith(".json") else ""
    log(f"refused {name or '?'}: {why}")
    if ID_RE.match(name):
        set_status(name, id=name, state="refused", message=why, finished_at=now())


# --- running one job ---
def run_job(req):
    rid, action = req["id"], req["action"]
    spec = ACTIONS[action]
    logpath = os.path.join(LOGS, f"{rid}.log")
    set_status(rid, id=rid, action=action, label=spec["label"], state="running",
               requested_by=req["requested_by"], started_at=now())
    ok, message = True, "Done."
    with open(logpath, "w") as lf:
        os.chmod(logpath, 0o644)
        lf.write(f"== {spec['label']} ==\n")
        lf.flush()
        env = dict(os.environ, **spec.get("env", {}))
        for step in spec["steps"]:
            lf.write(f"\n$ {' '.join(step)}\n")
            lf.flush()
            try:
                rc = subprocess.run(step, stdout=lf, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                    cwd=spec.get("cwd"), env=env, timeout=7200).returncode
            except (OSError, subprocess.TimeoutExpired) as e:
                lf.write(f"[could not run: {e}]\n")
                rc = 1
            if rc != 0:
                ok, message = False, f"A step failed (exit code {rc}). See the log."
                break
        after = spec.get("after")
        if ok and after == "parse_updates":
            try:
                parse_updates(lf)
            except Exception as e:  # never let a parsing problem fail the job
                lf.write(f"[could not list updates: {e}]\n")
    if action == "backup":
        try:
            backups_info()
        except Exception as e:  # the list is a convenience; never fail the job over it
            log(f"could not refresh the backup list: {e}")
    final = dict(state="succeeded" if ok else "failed", message=message, finished_at=now())
    if ok and spec.get("after") == "do_reboot":
        final["message"] = "The server is restarting now."
        set_status(rid, **final)
        prune_jobs()
        log("rebooting")
        subprocess.run(["systemctl", "reboot"], check=False)
        return
    set_status(rid, **final)
    prune_jobs()


def parse_updates(lf=None):
    """Ask apt what it WOULD upgrade (changes nothing) and save the list."""
    out = subprocess.run(["apt-get", "-s", "full-upgrade"], capture_output=True, text=True,
                         env=APT_ENV, timeout=300).stdout
    pkgs = []
    for line in out.splitlines():
        m = re.match(r"^Inst (\S+) (?:\[(\S+)\] )?\((\S+) ", line)
        if m:
            pkgs.append({"name": m.group(1), "from": m.group(2) or "", "to": m.group(3)})
    data = {"checked_at": now(), "count": len(pkgs), "packages": pkgs[:300],
            "reboot_required": os.path.exists(os.environ.get("ATHENA_REBOOT_FLAG", "/var/run/reboot-required"))}
    write_json(os.path.join(OUT, "updates.json"), data)
    if lf:
        lf.write(f"\n{len(pkgs)} package(s) can be updated.\n")
    return data


def prune_jobs():
    files = sorted((os.path.join(STATUS, f) for f in os.listdir(STATUS) if f.endswith(".json")),
                   key=os.path.getmtime, reverse=True)
    for p in files[KEEP_JOBS:]:
        rid = os.path.basename(p)[:-5]
        for q in (p, os.path.join(LOGS, f"{rid}.log")):
            try:
                os.remove(q)
            except OSError:
                pass


def run_queue():
    ensure_dirs()
    os.makedirs(os.path.dirname(LOCK_FILE), exist_ok=True)
    lock = open(LOCK_FILE, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log("another job is already running; it will pick up the queue")
        return 0
    while True:
        try:
            names = sorted((n for n in os.listdir(REQUESTS) if n.endswith(".json")),
                           key=lambda n: os.lstat(os.path.join(REQUESTS, n)).st_mtime)
        except OSError:
            names = []
        if not names:
            return 0
        path = os.path.join(REQUESTS, names[0])
        req, why = load_request(path)
        try:
            os.remove(path)   # consume it first, so it can never run twice
        except OSError:
            pass
        if req is None:
            rejected(path, why)
            continue
        log(f"running {req['action']} ({req['id']})")
        run_job(req)


# --- server health ---
def _read(path):
    with open(os.path.join(PROC, path)) as f:
        return f.read()


def cpu_times():
    parts = _read("stat").splitlines()[0].split()[1:]
    vals = [int(x) for x in parts]
    idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
    return sum(vals), idle


def memory():
    info = {}
    for line in _read("meminfo").splitlines():
        k, _, v = line.partition(":")
        info[k] = int(v.split()[0]) * 1024
    total = info["MemTotal"]
    avail = info.get("MemAvailable", info.get("MemFree", 0))
    return {"total": total, "used": total - avail, "percent": round(100 * (total - avail) / total, 1)}


def disk(path):
    u = shutil.disk_usage(path)
    return {"path": path, "total": u.total, "used": u.used, "free": u.free,
            "percent": round(100 * u.used / u.total, 1)}


def dir_size(path):
    total = 0
    for root, _, files in os.walk(path):
        for f in files:
            try:
                total += os.lstat(os.path.join(root, f)).st_size
            except OSError:
                pass
    return total

def database_bytes():
    """The size of the Athena database, asked of the database container. None if it cannot be asked."""
    try:
        r = subprocess.run(
            ["docker", "compose", "exec", "-T", "db", "sh", "-c",
             'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc "select pg_database_size(current_database())"'],
            cwd=ATHENA_DIR, capture_output=True, text=True, timeout=20)
        return int(r.stdout.strip()) if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None


def sizes():
    """Size of the Athena files and of the database. Slower to measure than the rest, so only every 10 minutes."""
    path = os.path.join(OUT, ".sizes.json")
    saved = read_json(path, None)
    if isinstance(saved, dict) and 0 <= now() - saved.get("t", 0) < SIZES_EVERY:
        return saved
    data = {"t": now(),
            "athena_bytes": dir_size(ATHENA_DIR) if os.path.isdir(ATHENA_DIR) else 0,
            "database_bytes": database_bytes()}
    write_json(path, data, 0o600)
    return data

def containers():
    project = os.path.basename(ATHENA_DIR.rstrip("/"))
    try:
        out = subprocess.run(["docker", "ps", "-a", "--filter", f"label=com.docker.compose.project={project}",
                              "--format", "{{.Names}}|{{.State}}|{{.Status}}"],
                             capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    result = []
    for line in out.splitlines():
        name, _, rest = line.partition("|")
        state, _, status = rest.partition("|")
        result.append({"name": name, "state": state, "status": status})
    return result


def os_pretty():
    try:
        for line in open("/etc/os-release"):
            if line.startswith("PRETTY_NAME="):
                return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


def backups_info():
    """The backup status and the list of backup files, for the admin page."""
    files = []
    if os.path.isdir(BACKUP_DIR):
        for name in os.listdir(BACKUP_DIR):
            if BACKUP_RE.match(name):
                try:
                    st = os.stat(os.path.join(BACKUP_DIR, name))
                except OSError:
                    continue
                files.append({"name": name, "bytes": st.st_size, "mtime": int(st.st_mtime)})
    files.sort(key=lambda f: f["name"], reverse=True)
    status = read_json(os.path.join(STATE_DIR, "backup-status.json"), {}) or {}
    try:
        with open(os.path.join(CONF_DIR, "usb-drives")) as f:
            drives = len([line for line in f if line.strip()])
    except OSError:
        drives = 0
    data = {"generated_at": now(), "status": status, "files": files[:30],
            "total_files": len(files), "usb_drives": drives}
    ensure_dirs()
    write_json(os.path.join(OUT, "backups.json"), data)
    return data


def health():
    ensure_dirs()
    t = now()
    total, idle = cpu_times()
    prev = read_json(os.path.join(OUT, ".cpu"), None)
    cpu = None
    if prev and total > prev["total"]:
        cpu = round(100 * (1 - (idle - prev["idle"]) / (total - prev["total"])), 1)
        cpu = max(0.0, min(100.0, cpu))
    write_json(os.path.join(OUT, ".cpu"), {"total": total, "idle": idle}, 0o600)
    mem = memory()
    load = os.getloadavg()
    up = float(_read("uptime").split()[0])
    updates = read_json(os.path.join(OUT, "updates.json"), {}) or {}
    ver = ""
    try:
        ver = open(os.path.join(ATHENA_DIR, "VERSION")).read().strip()
    except OSError:
        pass

    sz = sizes()
    
    data = {
        "generated_at": t,
        "cpu_percent": cpu,
        "cpu_count": os.cpu_count(),
        "load": [round(x, 2) for x in load],
        "memory": mem,
        "disk": disk("/"),
        "backups_bytes": dir_size(BACKUP_DIR) if os.path.isdir(BACKUP_DIR) else 0,
        "athena_bytes": sz["athena_bytes"],
        "database_bytes": sz["database_bytes"],
        "uptime_seconds": int(up),
        "reboot_required": os.path.exists(os.environ.get("ATHENA_REBOOT_FLAG", "/var/run/reboot-required")),
        "updates_pending": updates.get("count"),
        "updates_checked_at": updates.get("checked_at"),
        "containers": containers(),
        "kernel": os.uname().release,
        "os": os_pretty(),
        "hostname": os.uname().nodename,
        "athena_version": ver,
    }
    write_json(os.path.join(OUT, "health.json"), data)
    hist = read_json(os.path.join(OUT, "history.json"), []) or []
    if cpu is not None:
        hist.append({"t": t, "cpu": cpu, "mem": mem["percent"], "load": round(load[0], 2)})
    write_json(os.path.join(OUT, "history.json"), hist[-HISTORY_POINTS:])
    try:
        backups_info()
    except Exception as e:
        log(f"could not write the backup list: {e}")
    return data


def main(argv):
    if os.geteuid() != 0 and not os.environ.get("ATHENA_AGENT_TEST"):
        print("athena-agent must run as root.", file=sys.stderr)
        return 1
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "run-queue":
        return run_queue()
    if cmd == "health":
        health()
        return 0
    if cmd == "check":
        print(json.dumps(health(), indent=2))
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))